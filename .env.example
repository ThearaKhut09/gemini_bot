BOT_TOKEN=your_telegram_bot_token_here
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
IT_GROUP_ID=your_it_support_group_chat_id_here
MONITORED_GROUP_ID=
IT_SUPPORT_USERNAME=@your_it_username
PORT=3000
# Mini App: public HTTPS URL of the app (e.g. https://yourdomain.com/app or your ngrok URL + /app)
MINIAPP_URL=
# t.me deep link from BotFather /newapp (e.g. https://t.me/yourbot/itsupport) —
# used for the Open App button in groups, where Telegram rejects web_app buttons
MINIAPP_TG_LINK=
# Enable ONLY for local browser testing of the mini app (accepts a fake dev user)
# MINIAPP_DEV_MODE=1
